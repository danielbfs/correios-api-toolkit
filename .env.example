# Copie este arquivo para .env e preencha com SUAS credenciais.
# O arquivo .env está no .gitignore — NUNCA faça commit das credenciais reais.

# Usuário do Meu Correios
CORREIOS_USER=seu_usuario

# Código de acesso à API (gerado no portal cws/cwshom em "Gestão de acesso a APIs").
# NÃO é a senha de login do site.
CORREIOS_ACCESS_CODE=seu_codigo_de_acesso

# Ambiente do gateway de API: "hom" (homologação) ou "prod" (produção)
CORREIOS_ENV=hom

# (Opcional) Autenticação por contrato — se definido, o cliente usa /autentica/contrato
# CORREIOS_CONTRATO=9912345678
# CORREIOS_DR=72
